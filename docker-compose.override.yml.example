# Example docker-compose override for adding AzerothWebUI to a wow-server-playerbots
# (or any AzerothCore) docker-compose stack.
#
# Usage:
#   1. Copy this file into the target stack's directory as `docker-compose.override.yml`.
#   2. Build the AzerothWebUI image from this repo (`docker build -t azerothwebui .`), or
#      replace the `image:` line below with wherever you publish it.
#   3. Fill in AzerothCore__SoapUsername / AzerothCore__SoapPassword with a dedicated GM
#      SOAP account (see README's admin panel setup notes — do not reuse a personal account).
#   4. Apply AzerothWebUI.Api/Sql/001_create_admin_db.sql against ac-database, then seed the
#      first admin user (see README's "Run with Docker" section).
#   5. `docker compose up -d azerothwebui`

services:
  azerothwebui:
    image: azerothwebui:latest
    container_name: azerothwebui
    restart: unless-stopped
    networks:
      - ac-network
    depends_on:
      - ac-database
      - ac-worldserver
    ports:
      - "8080:8080"
    volumes:
      - ${DOCKER_VOL_ETC:-./env/dist/etc}:/azerothcore/env/dist/etc
    environment:
      AzerothCore__AuthConnectionString: "Server=ac-database;Port=3306;Database=acore_auth;User=root;Password=${DOCKER_DB_ROOT_PASSWORD:-password};"
      AzerothCore__CharactersConnectionString: "Server=ac-database;Port=3306;Database=acore_characters;User=root;Password=${DOCKER_DB_ROOT_PASSWORD:-password};"
      AzerothCore__WorldConnectionString: "Server=ac-database;Port=3306;Database=acore_world;User=root;Password=${DOCKER_DB_ROOT_PASSWORD:-password};"
      AzerothCore__SoapUrl: "http://ac-worldserver:7878/"
      AzerothCore__SoapUsername: "WEBUISOAP"
      AzerothCore__SoapPassword: "CHANGEME"
      AzerothCore__WorldserverConfigPath: "/azerothcore/env/dist/etc/worldserver.conf"
      AzerothCore__ModuleConfigDirectory: "/azerothcore/env/dist/etc/modules"
      AzerothWebUI__AdminConnectionString: "Server=ac-database;Port=3306;Database=azerothwebui;User=root;Password=${DOCKER_DB_ROOT_PASSWORD:-password};"

# No top-level `networks:` block needed here — as a docker-compose *override* (merged into
# the same compose project as the base file, not run as a separate project), `ac-network`
# already resolves to the network the base docker-compose.yml defines. Adding `external: true`
# here would be wrong: Compose prefixes network names with the project name unless a network
# is truly external to any compose-managed project (e.g. `docker network create ac-network`
# run by hand outside Compose), which isn't the case for this stack.
